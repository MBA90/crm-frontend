# Keycloak OIDC configuration for the crm-spa public client.
# Copy to `.env.local` and adjust for your environment.

# crm-gateway base URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8100

# Realm issuer URL (no trailing slash).
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/crm-realm

# Public client id (Authorization Code + PKCE, no client secret).
VITE_OIDC_CLIENT_ID=crm-spa

# Optional overrides (sensible defaults are derived from window.location.origin):
# VITE_OIDC_REDIRECT_URI=http://localhost:5174/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5174
# VITE_OIDC_SCOPE=openid crm-profile